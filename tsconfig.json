{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    /* ES2022 declares Intl.Segmenter, which the grapheme-aware character
       deletes need, and ES2024 declares String.prototype.isWellFormed, which
       their tests assert with. Both have shipped in Chrome since well before
       the MV3 baseline this extension targets. */
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "references": [{ "path": "./tsconfig.node.json" }],
  "include": ["src"]
}
