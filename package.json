{
  "name": "razorshell",
  "private": true,
  "version": "0.0.5",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --config vite.config.content.ts && vite build --config vite.config.pagehook.ts",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest",
    "test:stories": "vitest run --project storybook",
    "test:visual": "playwright test --project=visual",
    "test:e2e": "playwright test --project=e2e",
    "test:storybook": "playwright test --project=storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "preview": "vite preview",
    "check": "tsc --noEmit && eslint . --report-unused-disable-directives --max-warnings 0 && vitest run"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "10.5.8",
    "@storybook/addon-vitest": "10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@tailwindcss/typography": "^0.5.20",
    "@types/chrome": "^0.0.260",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/browser": "3.2.7",
    "autoprefixer": "^10.5.4",
    "daisyui": "^4.12.24",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fast-check": "^4.9.0",
    "gifenc": "^1.0.3",
    "globals": "^17.11.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.26",
    "storybook": "^10.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^3.2.7"
  }
}
