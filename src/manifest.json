{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "version": "0.0.4",
  "description": "__MSG_description__",
  "default_locale": "en",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "js": [
        "content.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "pagehook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "/images/16.png",
    "32": "/images/32.png",
    "48": "/images/48.png",
    "128": "/images/128.png"
  },
  "action": {
    "default_icon": {
      "16": "/images/16.png",
      "32": "/images/32.png",
      "48": "/images/48.png",
      "128": "/images/128.png"
    },
    "default_title": "Razorshell"
  },
  "background": {
    "service_worker": "service.js"
  },
  "commands": {
    "unix_word_rubout": {
      "description": "__MSG_command_unix_word_rubout__"
    },
    "transpose_chars": {
      "description": "__MSG_command_transpose_chars__"
    }
  },
  "host_permissions": [
    "*://*/*"
  ]
}
